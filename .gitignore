# Cores de EmulatorJS: 296 MB, se descargan de su release (ver README).
data/

# Dependencias
node_modules/

# Secreto de sesion y hashes de contrasenas: nunca al repositorio.
.env
.env.*
config/users.json
config/juegos.json
config/estadisticas.json

# Sistema y editores
*.log
.DS_Store
*.swp

# ROMs y partidas: contenido del usuario, nunca al repositorio.
roms/
saves/

# Portadas y animaciones de las consolas: contenido del usuario.
media/

# Copias de seguridad que deja el trabajo en el servidor. Nunca al repositorio:
# entre ellas hay volcados de ficheros de configuración con credenciales.
*.bak
*.bak[0-9]
*.pre-*

# Copias que se dejan al tocar un fichero a mano (server.js.antes-algo-20260813).
# Sirven para volver atras en el momento, no son el proyecto.
*.antes-*
*.pre-*
*.pre-*.bak

# El tema que elige cada usuario. Es suyo, no del proyecto.
config/temas.json
